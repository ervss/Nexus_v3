{
  "manifest_version": 3,
  "name": "Nexus Extreme Searcher",
  "version": "0.1.0",
  "description": "Search configured Nexus, torrent indexers and Reddit from a compact popup.",
  "icons": {
    "16": "icons/search-16.png",
    "32": "icons/search-32.png",
    "48": "icons/search-48.png",
    "128": "icons/search-128.png"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "http://127.0.0.1/*", "http://localhost/*",
    "http://*/*", "https://*/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Nexus Extreme Searcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/search-16.png",
      "32": "icons/search-32.png"
    }
  },
  "options_page": "options.html"
}
