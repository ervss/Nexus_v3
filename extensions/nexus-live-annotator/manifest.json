{
  "manifest_version": 3,
  "name": "Nexus Live Annotator",
  "version": "0.1.3",
  "description": "Annotate any webpage, save the marked screenshot, and copy it for ChatGPT.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "offscreen",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Annotate this page",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "toggle-annotator": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open or close Nexus Live Annotator"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "export.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
