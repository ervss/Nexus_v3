{
  "manifest_version": 3,
  "name": "Nexus Deck",
  "version": "1.1.1",
  "description": "Side panel pre lokálny Nexus dashboard s importom a pokročilým prehrávačom.",
  "action": {
    "default_title": "Otvoriť Nexus Deck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting", "contextMenus", "alarms", "downloads"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Otvoriť Nexus Deck"
    }
  }
}
