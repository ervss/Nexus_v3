{
  "manifest_version": 3,
  "name": "Multi-Vertical Video Player",
  "version": "1.1.1",
  "description": "Tri lokálne alebo priame video streamy vedľa seba s ovládaním synchronizácie.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "ikona16.png",
      "48": "ikona48.png",
      "128": "ikona128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
