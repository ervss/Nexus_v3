{
  "manifest_version": 3,
  "name": "Article Saver Funkcny",
  "version": "1.0.6",
  "description": "Uloží dostupný obsah článku ako Markdown na počítač.",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Uložiť článok"
  },
  "background": {
    "service_worker": "background.js"
  }
}
