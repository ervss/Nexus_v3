{
  "manifest_version": 3,
  "name": "Nexus Extreme Searcher v2",
  "version": "0.2.0",
  "description": "Search video sources, torrents, file hosts, public forums and Reddit.",
  "icons": {
    "16": "icons/search-16.png",
    "32": "icons/search-32.png",
    "48": "icons/search-48.png",
    "128": "icons/search-128.png"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "http://127.0.0.1/*", "http://localhost/*",
    "https://www.eporner.com/*", "https://www.reddit.com/*",
    "https://oauth.reddit.com/*", "https://api.theporndb.net/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Nexus Extreme Searcher v2",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/search-16.png",
      "32": "icons/search-32.png"
    }
  },
  "options_page": "options.html"
}
