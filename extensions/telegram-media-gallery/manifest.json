{
  "manifest_version": 3,
  "name": "Nexus Telegram Gallery",
  "version": "1.3.7",
  "description": "Veľká galéria nad panelom Media v Telegram Web. Prehratie, výber, sťahovanie a kolekcie cez akcie Telegramu.",
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
