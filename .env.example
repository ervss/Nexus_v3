# Required
SECRET_KEY=replace-with-a-long-random-secret
DASHBOARD_PASSWORD=replace-with-a-strong-password

# Database
DATABASE_URL=sqlite:///./nexus_test.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=300

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=false

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
LOG_TO_FILE=true
LOG_DIR=logs/server

# CORS / extension bridge
CORS_ALLOW_ALL=false
CORS_ALLOW_CHROME_EXTENSIONS=true
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ORIGIN_REGEX=
NEXUS_BRIDGE_TOKEN=

# Performance
PERFORMANCE_MODE=high
MAX_WORKERS=16
FFMPEG_THREADS=8
GPU_ACCELERATION=true

# Managed Tor (auto-started with Nexus when enabled)
TOR_ENABLED=false
TOR_AUTO_START=true
TOR_STOP_ON_SHUTDOWN=true
TOR_EXECUTABLE=
TOR_CONFIG_PATH=
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=

# Eporner network protection
EPORNER_USE_TOR=false
EPORNER_NETWORK_MODE=auto
EPORNER_TOR_PROXY=socks5h://127.0.0.1:9050
EPORNER_MIN_GAP=1.5
EPORNER_MAX_CONCURRENCY=3
EPORNER_ENRICH_CONCURRENCY=16
WHORESHUB_NETWORK_MODE=auto
CAMWHORES_NETWORK_MODE=direct
CAMWHORES_FAST_METADATA_CONCURRENCY=10
HUB_DETAIL_CACHE=1
HUB_DETAIL_CACHE_TTL_SECONDS=86400

# Optional integrations
BUNKR_API_KEY=
BUNKR_API_BASE=https://api.bunkrr.pics/v1
GOFILE_TOKEN=
WEBSHARE_TOKEN=
WEBSHARE_LOGIN=
WEBSHARE_PASSWORD=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# After login Telethon writes telegram_session.session in the repo root.
# Stream thumbnails are cached in data/telegram_thumbs/.
CAMWHORES_COOKIE_FILE=
SERPAPI_API_KEY=
TINEYE_API_KEY=

# Related Search / visual web matching
CBIR_CACHE_TTL_HOURS=24
CBIR_BROWSER_JOB_TTL_SECONDS=600
GOOGLE_VISION_API_KEY=
# Gemini Vision AI tagger
GEMINI_API_KEY=

# Optional private thumbnail broker for SerpApi (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGN_TTL_SECONDS=600

# Nexus Traffic Controller
NTC_PROXY_LIST=
WEBSHARE_PROXY_LIST=
MEGA_PROXY_URL=
MEGA_PROXY_MODE=

# Torrent pipeline
# Jackett is the default (port 9117). Prowlarr is the better long-term indexer
# manager: if both URL and API key are set, Nexus uses it and falls back to Jackett.
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=
JACKETT_TIMEOUT=40
PROWLARR_URL=
PROWLARR_API_KEY=
QBIT_URL=http://127.0.0.1:8080
QBIT_USER=admin
QBIT_PASS=
# Optional scene metadata. Leave empty to skip ThePornDB.
TPDB_API_KEY=
TORRENT_CATEGORY=6000
TORRENT_SEARCH_CACHE_TTL=90
TORRENT_THUMB_TTL=604800
TORRENT_THUMB_MISS_TTL=21600

# Adaptive playback priority; 0 keeps the baseline background budget.
NEXUS_PLAYBACK_PRIORITY=1
